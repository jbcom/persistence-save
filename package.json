{
  "name": "@arcade-cabinet/persistence-save",
  "version": "0.1.0",
  "description": "Generic save-game persistence facade over @capacitor-community/sqlite (jeep-sqlite/sql.js on web, native SQLite + SQLCipher on device) with a chained snapshot-migration walker, corrupt-save isolation, an autosave debounce/throttle scheduler, and a Capacitor Preferences KV bridge — extracted from Aethelgard-Chronicles-of-Strata's persistence layer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbcom/Aethelgard-Chronicles-of-Strata",
    "directory": "packages/persistence-save"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:cjs && pnpm run build:types && pnpm run build:fixup",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:fixup": "node scripts/fixup-cjs-package-json.mjs",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@capacitor-community/sqlite": ">=6.0.0",
    "@capacitor/core": ">=6.0.0",
    "@capacitor/preferences": ">=6.0.0",
    "jeep-sqlite": ">=2.7.0"
  },
  "peerDependenciesMeta": {
    "jeep-sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/core": "8.3.4",
    "@capacitor/preferences": "8.0.1",
    "jeep-sqlite": "2.8.0",
    "rimraf": "^6.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  }
}
